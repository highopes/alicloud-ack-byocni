#!/usr/bin/env bash
set -euo pipefail

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${KUP_CONFIG:-${SCRIPT_DIR}/kup.conf}"
PROFILE="${1:-status}"
CUSTOM_PROMPT_FILE="${2:-}"

usage() {
  printf 'usage: %s status|baseline|improved|custom [custom-prompt-file]\n' "$0" >&2
}

case "${PROFILE}" in
  status|baseline|improved)
    [[ -z "${CUSTOM_PROMPT_FILE}" ]] || { usage; exit 2; }
    ;;
  custom)
    [[ -n "${CUSTOM_PROMPT_FILE}" ]] || { usage; exit 2; }
    ;;
  *)
    usage
    exit 2
    ;;
esac

[[ -f "${CONFIG_FILE}" ]] || die "private config not found: ${CONFIG_FILE}"
chmod 600 "${CONFIG_FILE}"
set -a
# shellcheck disable=SC1090
source "${CONFIG_FILE}"
set +a

WORKDIR="${KUP_WORKDIR:-${SCRIPT_DIR}}"
KUBECONFIG_FILE="${KUBECONFIG_FILE:-${WORKDIR}/kubeconfig}"
RUNTIME_DIR="${RUNTIME_DIR:-${WORKDIR}/runtime}"
ACK_CONTEXT="${ACK_CONTEXT:-ack-byocni-demo}"
GALILEO_NAMESPACE="${GALILEO_NAMESPACE:-galileo-demo}"
GALILEO_PROMPT_SYNC_TIMEOUT_SEC="${GALILEO_PROMPT_SYNC_TIMEOUT_SEC:-300}"

need kubectl
need python3
[[ -f "${KUBECONFIG_FILE}" ]] || die "project-private kubeconfig not found: ${KUBECONFIG_FILE}; run ./kup first"
[[ "${RUNTIME_DIR}" == "${WORKDIR}/"* ]] || die "RUNTIME_DIR must remain inside KUP_WORKDIR"
[[ "${GALILEO_PROMPT_SYNC_TIMEOUT_SEC}" =~ ^[1-9][0-9]*$ ]] \
  || die "GALILEO_PROMPT_SYNC_TIMEOUT_SEC must be a positive integer"
mkdir -p "${RUNTIME_DIR}"

kctl() {
  kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" "$@"
}

ready_pod_snapshot() {
  kctl -n "${GALILEO_NAMESPACE}" get pod \
    -l app.kubernetes.io/name=splunk-ao-banking-qwen -o json | python3 -c '
import json, sys
for pod in json.load(sys.stdin).get("items", []):
    metadata = pod.get("metadata", {})
    status = pod.get("status", {})
    if metadata.get("deletionTimestamp"):
        continue
    if not any(c.get("type") == "Ready" and c.get("status") == "True" for c in status.get("conditions", [])):
        continue
    containers = status.get("containerStatuses", [])
    if not containers:
        continue
    container = next((item for item in containers if item.get("name") == "banking-chatbot"), containers[0])
    print("\t".join((metadata["name"], metadata["uid"], str(container.get("restartCount", 0)), container.get("imageID", ""))))
    break
'
}

show_status() {
  local snapshot pod_name pod_uid restart_count image_id image_digest configured mounted resolved
  snapshot="$(ready_pod_snapshot)"
  [[ -n "${snapshot}" ]] || die "no Ready Galileo application Pod found"
  IFS=$'\t' read -r pod_name pod_uid restart_count image_id <<< "${snapshot}"
  configured="$(kctl -n "${GALILEO_NAMESPACE}" get configmap splunk-ao-banking-qwen-config \
    -o jsonpath='{.data.SUPERVISOR_PROMPT_PROFILE}')"
  mounted="$(kctl -n "${GALILEO_NAMESPACE}" exec "${pod_name}" -- \
    sh -c 'test -n "$SUPERVISOR_PROMPT_PROFILE_FILE" && cat "$SUPERVISOR_PROMPT_PROFILE_FILE"')"
  resolved="$(kctl -n "${GALILEO_NAMESPACE}" exec "${pod_name}" -- python -c \
    'from src.splunk_ao_langgraph_fsi_agent.prompt_profiles import resolve_supervisor_prompt; print(resolve_supervisor_prompt()[0])')"
  printf 'Configured prompt profile: %s\n' "${configured}"
  printf 'Mounted prompt profile: %s\n' "${mounted}"
  printf 'Resolved application profile: %s\n' "${resolved}"
  printf 'Application Pod: %s\n' "${pod_name}"
  printf 'Pod UID: %s\n' "${pod_uid}"
  printf 'Container restart count: %s\n' "${restart_count}"
  image_digest="${image_id##*@}"
  printf 'Container image digest: %s\n' "${image_digest}"
  [[ "${configured}" == "${mounted}" && "${mounted}" == "${resolved}" ]] \
    || die "prompt state is not converged: configured=${configured}, mounted=${mounted}, resolved=${resolved}"
}

if [[ "${PROFILE}" == "status" ]]; then
  show_status
  exit 0
fi

before_snapshot="$(ready_pod_snapshot)"
[[ -n "${before_snapshot}" ]] || die "no Ready Galileo application Pod found"
IFS=$'\t' read -r before_pod before_uid before_restarts before_image_id <<< "${before_snapshot}"

patch_file="$(mktemp "${RUNTIME_DIR}/galileo-prompt-patch.XXXXXX")"
trap 'rm -f -- "${patch_file}"' EXIT
chmod 600 "${patch_file}"

python3 - "${PROFILE}" "${patch_file}" "${CUSTOM_PROMPT_FILE}" <<'PY'
import json
import sys
from pathlib import Path

profile, destination, custom_source = sys.argv[1:]
custom_prompt = ""
if profile == "custom":
    source = Path(custom_source)
    if not source.is_file():
        raise SystemExit(f"custom prompt file does not exist: {source}")
    custom_prompt = source.read_text(encoding="utf-8").strip()
    if not custom_prompt:
        raise SystemExit("custom prompt file is empty")
    if len(custom_prompt.encode("utf-8")) > 100_000:
        raise SystemExit("custom prompt must be no larger than 100 KiB")
Path(destination).write_text(
    json.dumps(
        {"data": {"SUPERVISOR_PROMPT_PROFILE": profile, "SUPERVISOR_PROMPT_CUSTOM": custom_prompt}},
        ensure_ascii=False,
    ),
    encoding="utf-8",
)
PY
expected_custom_hash="$(python3 - "${patch_file}" <<'PY'
import hashlib
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    prompt = json.load(handle)["data"]["SUPERVISOR_PROMPT_CUSTOM"]
print(hashlib.sha256(prompt.encode("utf-8")).hexdigest() if prompt else "")
PY
)"

kctl -n "${GALILEO_NAMESPACE}" patch configmap splunk-ao-banking-qwen-config \
  --type merge --patch-file "${patch_file}" >/dev/null

log "waiting for the projected ConfigMap and application resolver to report ${PROFILE}"
resolved_profile=""
resolved_custom_hash=""
mounted_profile=""
deadline=$((SECONDS + GALILEO_PROMPT_SYNC_TIMEOUT_SEC))
while (( SECONDS < deadline )); do
  runtime_info="$(kctl -n "${GALILEO_NAMESPACE}" exec "${before_pod}" -- python -c \
    'import os; from hashlib import sha256; from pathlib import Path; from src.splunk_ao_langgraph_fsi_agent.prompt_profiles import resolve_supervisor_prompt; m=Path(os.environ["SUPERVISOR_PROMPT_PROFILE_FILE"]).read_text().strip(); p,v=resolve_supervisor_prompt(); print(m+"\t"+p+"\t"+sha256(v.encode()).hexdigest())' \
    2>/dev/null || true)"
  IFS=$'\t' read -r mounted_profile resolved_profile resolved_custom_hash <<< "${runtime_info}"
  if [[ "${mounted_profile}" == "${PROFILE}" && "${resolved_profile}" == "${PROFILE}" ]]; then
    if [[ "${PROFILE}" != "custom" || "${resolved_custom_hash}" == "${expected_custom_hash}" ]]; then
      break
    fi
  fi
  (( SECONDS < deadline )) || break
  sleep 2
done

[[ "${mounted_profile}" == "${PROFILE}" && "${resolved_profile}" == "${PROFILE}" ]] \
  || die "prompt switch timed out: expected ${PROFILE}, mounted ${mounted_profile:-unavailable}, resolved ${resolved_profile:-unavailable}"
if [[ "${PROFILE}" == "custom" ]]; then
  [[ "${resolved_custom_hash}" == "${expected_custom_hash}" ]] \
    || die "application resolved custom profile but not the requested prompt content"
fi

after_snapshot="$(ready_pod_snapshot)"
[[ -n "${after_snapshot}" ]] || die "no Ready Galileo application Pod found after prompt switch"
IFS=$'\t' read -r after_pod after_uid after_restarts after_image_id <<< "${after_snapshot}"
[[ "${after_pod}" == "${before_pod}" && "${after_uid}" == "${before_uid}" ]] \
  || die "application Pod changed during a ConfigMap-only prompt switch"
[[ "${after_restarts}" == "${before_restarts}" ]] \
  || die "application container restarted during a ConfigMap-only prompt switch"
[[ "${after_image_id}" == "${before_image_id}" ]] \
  || die "application image changed during a ConfigMap-only prompt switch"

show_status
log "prompt switch complete; Pod and image were preserved. Start a new Chainlit chat to use ${PROFILE}."
