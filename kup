#!/usr/bin/env bash
set -euo pipefail

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${KUP_CONFIG:-${SCRIPT_DIR}/kup.conf}"

[[ -f "${CONFIG_FILE}" ]] || die "private config not found: ${CONFIG_FILE}; copy kup.conf.example to kup.conf first"
chmod 600 "${CONFIG_FILE}"

set -a
# shellcheck disable=SC1090
source "${CONFIG_FILE}"
set +a

WORKDIR="${KUP_WORKDIR:-${SCRIPT_DIR}}"
KUBECONFIG_FILE="${KUBECONFIG_FILE:-${WORKDIR}/kubeconfig}"
RUNTIME_DIR="${RUNTIME_DIR:-${WORKDIR}/runtime}"
ACK_CONTEXT="${ACK_CONTEXT:-ack-byocni-demo}"
ACK_API_TIMEOUT="${ACK_API_TIMEOUT:-10s}"
CILIUM_ROLLOUT_TIMEOUT="${CILIUM_ROLLOUT_TIMEOUT:-20m}"
TETRAGON_ROLLOUT_TIMEOUT="${TETRAGON_ROLLOUT_TIMEOUT:-15m}"
HELM_ROLLOUT_TIMEOUT="${HELM_ROLLOUT_TIMEOUT:-20m}"
NODE_DISCOVERY_TIMEOUT_SEC="${NODE_DISCOVERY_TIMEOUT_SEC:-2400}"
TETRAGON_EXPORT_DENYLIST="${TETRAGON_EXPORT_DENYLIST:-}"
export GALILEO_SPLUNK_AO_EXPERIMENT_DATASET="${GALILEO_SPLUNK_AO_EXPERIMENT_DATASET:-}"

require_var() {
  local name="$1"
  local value="${!name:-}"
  [[ -n "${value}" ]] || die "required setting is empty: ${name}"
  case "${value}" in
    ReplaceMe|REPLACE_ME|replace-me|CONTACT.*) die "replace placeholder value for ${name} in the private kup.conf" ;;
  esac
}

require_bool() {
  local name="$1"
  local value="${!name:-}"
  case "${value}" in
    true|false) ;;
    *) die "${name} must be true or false" ;;
  esac
}

for command_name in terraform kubectl helm python3 curl awk sed base64; do
  need "${command_name}"
done

for setting_name in \
  ALICLOUD_ACCESS_KEY ALICLOUD_SECRET_KEY ACK_NODE_PASSWORD ISO_REPO_URL \
  ALIBABA_CLOUD_REGION ACK_NAME_PREFIX ACK_CLUSTER_SPEC ACK_VPC_CIDR ACK_VSW_CIDR \
  ACK_POD_CIDR ACK_SERVICE_CIDR ACK_NODE_CIDR_MASK ACK_INSTANCE_TYPE ACK_NODE_COUNT \
  ACK_SYSTEM_DISK_CATEGORY ACK_SYSTEM_DISK_SIZE ACK_ENABLE_NAT_GATEWAY \
  ACK_ENABLE_PUBLIC_APISERVER CILIUM_CLUSTER_NAME CILIUM_CLUSTER_ID \
  CILIUM_CHART_VER TETRAGON_CHART_VER TPR_CHART_VER HUBBLE_UI_CHART_VER \
  HUBBLE_TIMESCAPE_CHART_VER HUBBLE_ENTERPRISE_CHART_VER DEMO_NAMESPACE TEST_NAMESPACE \
  HUBBLE_UI_LOCAL_PORT TETRAGON_EXPORT_DIRECTORY TETRAGON_EXPORT_FILENAME \
  TETRAGON_ALERT_EXPORT_DIRECTORY TETRAGON_EXPORT_ALLOWLIST TETRAGON_CGROUP_RATE \
  GALILEO_NAMESPACE GALILEO_SOURCE_URL GALILEO_SOURCE_COMMIT GALILEO_IMAGE_REF \
  GALILEO_REGISTRY_SERVER GALILEO_REGISTRY_USERNAME GALILEO_REGISTRY_PASSWORD \
  GALILEO_SPLUNK_AO_API_KEY GALILEO_SPLUNK_AO_PROJECT GALILEO_SPLUNK_AO_AGENT_STREAM \
  GALILEO_SPLUNK_AO_CONSOLE_URL GALILEO_APP_MODEL_PROVIDER GALILEO_APP_MODEL_NAME \
  GALILEO_APP_MODEL_BASE_URL GALILEO_APP_MODEL_API_KEY GALILEO_MODEL_REQUEST_TIMEOUT \
  GALILEO_MODEL_MAX_RETRIES GALILEO_PINECONE_API_KEY GALILEO_PINECONE_INDEX_NAME \
  GALILEO_PINECONE_NAMESPACE GALILEO_PINECONE_TEXT_FIELD \
  GALILEO_SPLUNK_AO_EXPERIMENT_EVALUATORS GALILEO_SUPERVISOR_PROMPT_PROFILE \
  GALILEO_PROMPT_SYNC_TIMEOUT_SEC GALILEO_LOCAL_PORT; do
  require_var "${setting_name}"
done
require_bool ACK_ENABLE_NAT_GATEWAY
require_bool ACK_ENABLE_PUBLIC_APISERVER

[[ -f "${WORKDIR}/main.tf" ]] || die "Terraform configuration not found in KUP_WORKDIR: ${WORKDIR}/main.tf"
[[ "${KUBECONFIG_FILE}" == "${WORKDIR}/"* ]] || die "KUBECONFIG_FILE must remain inside KUP_WORKDIR"
[[ "${RUNTIME_DIR}" == "${WORKDIR}/"* ]] || die "RUNTIME_DIR must remain inside KUP_WORKDIR"

for required_file in \
  cilium-enterprise-values.yaml hubble-enterprise-values.yaml hubble-timescape-values.yaml \
  hubble-ui-values.yaml tetragon.yaml tpr-values.yaml ns_test/testcurl.yaml \
  ns_demo/mini-boutique-lite.yaml ns_demo/cnp-l7-visibility.yaml \
  ns_galileo/multi-agent-banking.yaml ns_galileo/supervisor-production-example.txt \
  galileo-prompt; do
  [[ -f "${SCRIPT_DIR}/${required_file}" ]] || die "required file not found: ${SCRIPT_DIR}/${required_file}"
done

python3 - "${ACK_VPC_CIDR}" "${ACK_VSW_CIDR}" "${ACK_POD_CIDR}" "${ACK_SERVICE_CIDR}" <<'PY'
import ipaddress
import sys

vpc, vsw, pod, service = [ipaddress.ip_network(value, strict=True) for value in sys.argv[1:]]
if not vsw.subnet_of(vpc):
    raise SystemExit(f"vSwitch CIDR {vsw} must be inside VPC CIDR {vpc}")
for left_name, left, right_name, right in (
    ("VPC", vpc, "Pod", pod),
    ("VPC", vpc, "Service", service),
    ("Pod", pod, "Service", service),
):
    if left.overlaps(right):
        raise SystemExit(f"{left_name} CIDR {left} overlaps {right_name} CIDR {right}")
PY

[[ "${GALILEO_SOURCE_COMMIT}" =~ ^[0-9a-f]{40}$ ]] \
  || die "GALILEO_SOURCE_COMMIT must be a full lowercase Git commit SHA"
[[ "${GALILEO_IMAGE_REF}" == "${GALILEO_REGISTRY_SERVER}/"*@sha256:* ]] \
  || die "GALILEO_IMAGE_REF must be an immutable digest in GALILEO_REGISTRY_SERVER"
galileo_image_digest="${GALILEO_IMAGE_REF##*@sha256:}"
[[ "${galileo_image_digest}" =~ ^[0-9a-f]{64}$ ]] \
  || die "GALILEO_IMAGE_REF must end in a complete lowercase sha256 digest"
unset galileo_image_digest
[[ "${GALILEO_APP_MODEL_BASE_URL}" == https://* ]] \
  || die "GALILEO_APP_MODEL_BASE_URL must use HTTPS"
case "${GALILEO_APP_MODEL_PROVIDER}" in
  bailian|vllm) ;;
  *) die "GALILEO_APP_MODEL_PROVIDER must be bailian or vllm" ;;
esac
case "${GALILEO_SUPERVISOR_PROMPT_PROFILE}" in
  baseline|improved) ;;
  *) die "GALILEO_SUPERVISOR_PROMPT_PROFILE must be baseline or improved; use ./galileo-prompt for custom prompts" ;;
esac
[[ "${GALILEO_PROMPT_SYNC_TIMEOUT_SEC}" =~ ^[1-9][0-9]*$ ]] \
  || die "GALILEO_PROMPT_SYNC_TIMEOUT_SEC must be a positive integer"
for secret_name in \
  GALILEO_REGISTRY_PASSWORD GALILEO_SPLUNK_AO_API_KEY \
  GALILEO_APP_MODEL_API_KEY GALILEO_PINECONE_API_KEY; do
  secret_value="${!secret_name}"
  [[ "${secret_value}" != *$'\n'* && "${secret_value}" != *$'\r'* ]] \
    || die "${secret_name} contains an unsupported newline"
done
unset secret_name secret_value

mkdir -p "${RUNTIME_DIR}"
cd "${WORKDIR}"

export ALICLOUD_ACCESS_KEY ALICLOUD_SECRET_KEY
export ALICLOUD_REGION="${ALIBABA_CLOUD_REGION}"
export TF_IN_AUTOMATION=1
export TF_INPUT=0

export TF_VAR_region="${ALIBABA_CLOUD_REGION}"
export TF_VAR_name_prefix="${ACK_NAME_PREFIX}"
export TF_VAR_vpc_cidr="${ACK_VPC_CIDR}"
export TF_VAR_vsw_cidr="${ACK_VSW_CIDR}"
export TF_VAR_pod_cidr="${ACK_POD_CIDR}"
export TF_VAR_service_cidr="${ACK_SERVICE_CIDR}"
export TF_VAR_node_cidr_mask="${ACK_NODE_CIDR_MASK}"
export TF_VAR_cluster_spec="${ACK_CLUSTER_SPEC}"
export TF_VAR_enable_nat_gateway="${ACK_ENABLE_NAT_GATEWAY}"
export TF_VAR_enable_public_apiserver="${ACK_ENABLE_PUBLIC_APISERVER}"
export TF_VAR_node_pool_desired_size="${ACK_NODE_COUNT}"
export TF_VAR_instance_type="${ACK_INSTANCE_TYPE}"
export TF_VAR_system_disk_category="${ACK_SYSTEM_DISK_CATEGORY}"
export TF_VAR_system_disk_size="${ACK_SYSTEM_DISK_SIZE}"
export TF_VAR_node_password="${ACK_NODE_PASSWORD}"
export TF_VAR_zone_id="${ACK_ZONE_ID:-}"

kctl() {
  kubectl \
    --kubeconfig "${KUBECONFIG_FILE}" \
    --context "${ACK_CONTEXT}" \
    "$@"
}

hctl() {
  helm \
    --kubeconfig "${KUBECONFIG_FILE}" \
    --kube-context "${ACK_CONTEXT}" \
    "$@"
}

recover_pending_helm_revision() {
  local release="$1"
  local namespace="$2"
  local history_json pending_revision

  history_json="$(hctl history "${release}" --namespace "${namespace}" -o json 2>/dev/null || true)"
  [[ -n "${history_json}" ]] || return 0
  pending_revision="$(printf '%s' "${history_json}" | python3 -c '
import json, sys
try:
    history = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)
if not history:
    raise SystemExit(0)
latest = history[-1]
if str(latest.get("status", "")).startswith("pending-"):
    print(latest.get("revision", ""))
')"

  if [[ -n "${pending_revision}" ]]; then
    log "remove interrupted Helm ${release} pending revision ${pending_revision} before retry"
    kctl -n "${namespace}" delete secret \
      "sh.helm.release.v1.${release}.v${pending_revision}" \
      --ignore-not-found >/dev/null
  fi
}

helm_release_is_deployed() {
  local release="$1"
  local namespace="$2"
  hctl status "${release}" --namespace "${namespace}" -o json 2>/dev/null | python3 -c '
import json, sys
try:
    status = json.load(sys.stdin).get("info", {}).get("status")
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if status == "deployed" else 1)
'
}

helm_upgrade() {
  local release="$1"
  local namespace="kube-system"
  local attempt

  recover_pending_helm_revision "${release}" "${namespace}"
  for ((attempt = 1; attempt <= 3; attempt++)); do
    if hctl upgrade --install "$@"; then
      if helm_release_is_deployed "${release}" "${namespace}"; then
        return 0
      fi
      log "Helm command returned success but ${namespace}/${release} is not deployed"
    fi
    if [[ "${attempt}" -lt 3 ]]; then
      recover_pending_helm_revision "${release}" "${namespace}"
      log "Helm convergence failed (attempt ${attempt}/3); retrying after 15 seconds"
      sleep 15
    fi
  done
  return 1
}

redact_secrets() {
  python3 -c '
import os, sys
values = [
    os.environ.get(name, "")
    for name in (
        "ALICLOUD_ACCESS_KEY", "ALICLOUD_SECRET_KEY", "ACK_NODE_PASSWORD", "ISO_REPO_URL",
        "GALILEO_REGISTRY_USERNAME", "GALILEO_REGISTRY_PASSWORD",
        "GALILEO_SPLUNK_AO_API_KEY", "GALILEO_APP_MODEL_API_KEY", "GALILEO_PINECONE_API_KEY",
    )
]
for line in sys.stdin:
    for value in values:
        if value:
            line = line.replace(value, "<redacted>")
    sys.stdout.write(line)
    sys.stdout.flush()
'
}

run_terraform() {
  terraform "$@" 2>&1 | redact_secrets
}

terraform_apply() (
  local attempt apply_log apply_status
  umask 077
  apply_log="$(mktemp "${RUNTIME_DIR}/terraform-apply.XXXXXX")"
  trap 'rm -f -- "${apply_log}"' EXIT

  for ((attempt = 1; attempt <= 3; attempt++)); do
    if run_terraform apply -auto-approve -input=false | tee "${apply_log}"; then
      return 0
    else
      apply_status=$?
    fi

    if grep -Fq 'InvalidAccountStatus.NotEnoughBalance' "${apply_log}"; then
      die "Alibaba Cloud rejected the PostPaid Worker order because the account has insufficient available balance. Restore the account's available balance/credit to the Alibaba Cloud PostPaid threshold (the official error-code guidance currently specifies at least CNY 100), settle any overdue bill, then rerun ./kup. Terraform state is preserved and the next run will continue with the missing Node Pool."
    fi
    if grep -Eq 'Account\.Arrearage|InvalidInstance\.UnPaidOrder' "${apply_log}"; then
      die "Alibaba Cloud rejected the order because the account has an overdue or unpaid bill. Settle it in Expenses and Costs, then rerun ./kup; Terraform state is preserved."
    fi
    if grep -Eq 'PaymentMethodNotFound|InvalidPayMethod' "${apply_log}"; then
      die "Alibaba Cloud rejected the order because the account has no usable payment method. Configure one in Expenses and Costs, then rerun ./kup; Terraform state is preserved."
    fi
    if grep -Fq 'InsufficientBalance.AgentCredit' "${apply_log}"; then
      die "Alibaba Cloud reported insufficient reseller/agent credit. Contact the account's channel partner, then rerun ./kup; Terraform state is preserved."
    fi
    if (( attempt == 3 )); then
      return "${apply_status}"
    fi
    log "Terraform apply attempt ${attempt} failed; retry in 15 seconds"
    sleep 15
  done
)

render_template() {
  local input_file="$1"
  local output_file="$2"
  python3 - "${input_file}" "${output_file}" <<'PY'
import os
import sys
from string import Template

source, destination = sys.argv[1:]
with open(source, "r", encoding="utf-8") as handle:
    rendered = Template(handle.read()).substitute(os.environ)
with open(destination, "w", encoding="utf-8") as handle:
    handle.write(rendered)
PY
}

normalize_context() {
  local original_context
  original_context="$(kubectl --kubeconfig "${KUBECONFIG_FILE}" config current-context)"
  [[ -n "${original_context}" ]] || die "generated kubeconfig has no current context"

  if [[ "${original_context}" != "${ACK_CONTEXT}" ]]; then
    if kubectl --kubeconfig "${KUBECONFIG_FILE}" config get-contexts -o name | awk -v wanted="${ACK_CONTEXT}" '$0 == wanted { found=1 } END { exit(found ? 0 : 1) }'; then
      kubectl --kubeconfig "${KUBECONFIG_FILE}" config delete-context "${ACK_CONTEXT}" >/dev/null
    fi
    kubectl --kubeconfig "${KUBECONFIG_FILE}" config rename-context "${original_context}" "${ACK_CONTEXT}" >/dev/null
  fi
  kubectl --kubeconfig "${KUBECONFIG_FILE}" config use-context "${ACK_CONTEXT}" >/dev/null
}

wait_for_api() {
  local attempt
  for ((attempt = 1; attempt <= 120; attempt++)); do
    if kctl --request-timeout="${ACK_API_TIMEOUT}" get --raw=/readyz >/dev/null 2>&1; then
      return 0
    fi
    sleep 5
  done
  die "ACK API server did not become reachable"
}

wait_for_nodes_and_podcidrs() {
  local deadline now summary count assigned
  deadline=$(( $(date +%s) + NODE_DISCOVERY_TIMEOUT_SEC ))
  while :; do
    summary="$(kctl get nodes -o json 2>/dev/null | python3 -c '
import json, sys
items = json.load(sys.stdin).get("items", [])
print(len(items), sum(bool(item.get("spec", {}).get("podCIDR")) for item in items))
' 2>/dev/null || true)"
    count="${summary%% *}"
    assigned="${summary##* }"
    if [[ "${count:-0}" -ge "${ACK_NODE_COUNT}" && "${assigned:-0}" -eq "${count:-0}" ]]; then
      log "ACK workers discovered: ${count}; PodCIDR assigned: ${assigned}"
      return 0
    fi
    now="$(date +%s)"
    if [[ "${now}" -ge "${deadline}" ]]; then
      kctl get nodes -o wide || true
      die "timed out waiting for ${ACK_NODE_COUNT} workers with PodCIDR assignments"
    fi
    sleep 10
  done
}

wait_for_cilium_health() {
  local attempt
  for ((attempt = 1; attempt <= 60; attempt++)); do
    if kctl -n kube-system exec daemonset/cilium -c cilium-agent -- cilium-dbg status --brief >/dev/null 2>&1; then
      return 0
    fi
    sleep 10
  done
  kctl -n kube-system exec daemonset/cilium -c cilium-agent -- cilium-dbg status || true
  die "Cilium agent status did not become healthy"
}

restart_cilium_if_flow_export_missing() {
  local attempt
  for ((attempt = 1; attempt <= 3; attempt++)); do
    if kctl -n kube-system exec daemonset/cilium -c cilium-agent -- \
      sh -c 'test -s /var/run/cilium/hubble/hubble.log' >/dev/null 2>&1; then
      return 0
    fi
    sleep 5
  done

  log "Cilium flow export is configured but not active; perform a one-time DaemonSet rollout"
  kctl -n kube-system rollout restart daemonset/cilium
}

wait_for_hubble_flow_export() {
  local attempt pods pod missing
  for ((attempt = 1; attempt <= 60; attempt++)); do
    pods="$(kctl -n kube-system get pod -l k8s-app=cilium \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
    missing=0
    while IFS= read -r pod; do
      [[ -n "${pod}" ]] || continue
      if ! kctl -n kube-system exec "${pod}" -c cilium-agent -- \
        sh -c 'test -s /var/run/cilium/hubble/hubble.log' >/dev/null 2>&1; then
        missing=1
      fi
    done <<< "${pods}"
    if [[ -n "${pods}" && "${missing}" -eq 0 ]]; then
      log "Hubble static flow export is non-empty on every Cilium node"
      return 0
    fi
    sleep 5
  done
  die "Hubble flow export did not become non-empty on every Cilium node"
}

validate_chart() {
  local release="$1"
  local chart="$2"
  local version="$3"
  local values_file="$4"
  local safe_name="${release//[^A-Za-z0-9_.-]/-}"

  log "validate Helm chart ${chart} ${version}"
  helm show chart "${chart}" --version "${version}" > "${RUNTIME_DIR}/${safe_name}-chart.yaml"
  helm show values "${chart}" --version "${version}" > "${RUNTIME_DIR}/${safe_name}-default-values.yaml"
  helm template "${release}" "${chart}" \
    --version "${version}" \
    --namespace kube-system \
    -f "${values_file}" > "${RUNTIME_DIR}/${safe_name}-rendered.yaml"
}

ensure_namespace() {
  local namespace="$1"
  if ! kctl get namespace "${namespace}" >/dev/null 2>&1; then
    kctl create namespace "${namespace}" >/dev/null
  fi
}

create_galileo_secrets() {
  (
    local runtime_secret_file registry_auth_file
    umask 077
    runtime_secret_file="$(mktemp "${RUNTIME_DIR}/galileo-runtime-secret.XXXXXX")"
    registry_auth_file="$(mktemp "${RUNTIME_DIR}/galileo-registry-auth.XXXXXX")"
    trap 'rm -f -- "${runtime_secret_file}" "${registry_auth_file}"' EXIT

    python3 - "${runtime_secret_file}" "${registry_auth_file}" <<'PY'
import base64
import json
import os
import sys
from pathlib import Path

runtime_path, registry_path = map(Path, sys.argv[1:])
runtime_values = {
    "SPLUNK_AO_API_KEY": os.environ["GALILEO_SPLUNK_AO_API_KEY"],
    "APP_MODEL_API_KEY": os.environ["GALILEO_APP_MODEL_API_KEY"],
    "PINECONE_API_KEY": os.environ["GALILEO_PINECONE_API_KEY"],
}
runtime_path.write_text(
    "".join(f"{name}={value}\n" for name, value in runtime_values.items()),
    encoding="utf-8",
)

server = os.environ["GALILEO_REGISTRY_SERVER"]
username = os.environ["GALILEO_REGISTRY_USERNAME"]
password = os.environ["GALILEO_REGISTRY_PASSWORD"]
auth = base64.b64encode(f"{username}:{password}".encode()).decode()
registry_path.write_text(
    json.dumps({"auths": {server: {"username": username, "password": password, "auth": auth}}}),
    encoding="utf-8",
)
runtime_path.chmod(0o600)
registry_path.chmod(0o600)
PY

    kctl -n "${GALILEO_NAMESPACE}" create secret generic splunk-ao-banking-qwen-runtime \
      --from-env-file="${runtime_secret_file}" --dry-run=client -o yaml \
      | kctl apply -f -
    kctl -n "${GALILEO_NAMESPACE}" create secret generic galileo-registry-pull \
      --type=kubernetes.io/dockerconfigjson \
      --from-file=.dockerconfigjson="${registry_auth_file}" \
      --dry-run=client -o yaml \
      | kctl apply -f -
  )
}

validate_application_networking() {
  local pods source_pod target_ip pod
  pods="$(kctl -n "${TEST_NAMESPACE}" get pod -l app=testcurl -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.status.podIP}{"\n"}{end}')"
  source_pod="$(printf '%s\n' "${pods}" | awk 'NF >= 2 {print $1; exit}')"
  target_ip="$(printf '%s\n' "${pods}" | awk 'NF >= 2 {print $2}' | sed -n '2p')"
  [[ -n "${source_pod}" ]] || die "no testcurl pod is available for network validation"
  [[ -n "${target_ip}" ]] || target_ip="$(printf '%s\n' "${pods}" | awk 'NF >= 2 {print $2; exit}')"

  log "validate DNS, pod-to-pod, pod-to-service, and external HTTPS"
  kctl -n "${TEST_NAMESPACE}" exec "${source_pod}" -- nslookup kubernetes.default.svc.cluster.local >/dev/null
  kctl -n "${TEST_NAMESPACE}" exec "${source_pod}" -- ping -c 2 -W 5 "${target_ip}" >/dev/null
  kctl -n "${TEST_NAMESPACE}" exec "${source_pod}" -- curl -fsS --max-time 20 \
    "http://frontend.${DEMO_NAMESPACE}.svc.cluster.local/" >/dev/null
  kctl -n "${TEST_NAMESPACE}" exec "${source_pod}" -- curl -fsSI --max-time 30 \
    https://www.cisco.com/ >/dev/null

  while IFS= read -r pod; do
    [[ -n "${pod}" ]] || continue
    kctl -n "${TEST_NAMESPACE}" exec "${pod}" -- curl -fsS --max-time 20 \
      "http://frontend.${DEMO_NAMESPACE}.svc.cluster.local/" >/dev/null
  done < <(printf '%s\n' "${pods}" | awk 'NF >= 2 {print $1}')
}

validate_galileo_prompt_runtime() {
  local app_pod="$1"
  local configured_profile mounted_profile resolved_profile deadline runtime_info

  kctl -n "${GALILEO_NAMESPACE}" get deployment splunk-ao-banking-qwen -o json | python3 -c '
import json, sys

deployment = json.load(sys.stdin)
spec = deployment["spec"]["template"]["spec"]
container = next(item for item in spec["containers"] if item["name"] == "banking-chatbot")
environment = {item["name"]: item.get("value") for item in container.get("env", [])}
expected_environment = {
    "SUPERVISOR_PROMPT_PROFILE_FILE": "/etc/banking-prompt/SUPERVISOR_PROMPT_PROFILE",
    "SUPERVISOR_PROMPT_CUSTOM_FILE": "/etc/banking-prompt/SUPERVISOR_PROMPT_CUSTOM",
}
if any(environment.get(name) != value for name, value in expected_environment.items()):
    raise SystemExit("Galileo prompt file environment is missing or incorrect")
mount = next((item for item in container.get("volumeMounts", []) if item.get("name") == "supervisor-prompt"), None)
if not mount or mount.get("mountPath") != "/etc/banking-prompt" or not mount.get("readOnly"):
    raise SystemExit("Galileo projected prompt volume mount is missing or incorrect")
volume = next((item for item in spec.get("volumes", []) if item.get("name") == "supervisor-prompt"), None)
if not volume or volume.get("configMap", {}).get("name") != "splunk-ao-banking-qwen-config":
    raise SystemExit("Galileo projected prompt ConfigMap volume is missing or incorrect")
items = {item.get("key"): item.get("path") for item in volume["configMap"].get("items", [])}
expected_items = {
    "SUPERVISOR_PROMPT_PROFILE": "SUPERVISOR_PROMPT_PROFILE",
    "SUPERVISOR_PROMPT_CUSTOM": "SUPERVISOR_PROMPT_CUSTOM",
}
if items != expected_items:
    raise SystemExit("Galileo projected prompt ConfigMap items are missing or incorrect")
'

  configured_profile="$(kctl -n "${GALILEO_NAMESPACE}" get configmap \
    splunk-ao-banking-qwen-config -o json | python3 -c '
import json, sys
data = json.load(sys.stdin).get("data", {})
if data.get("SUPERVISOR_PROMPT_CUSTOM") != "":
    raise SystemExit("fresh kup must clear SUPERVISOR_PROMPT_CUSTOM")
print(data.get("SUPERVISOR_PROMPT_PROFILE", ""))
')"
  [[ "${configured_profile}" == "${GALILEO_SUPERVISOR_PROMPT_PROFILE}" ]] \
    || die "Galileo ConfigMap prompt profile does not match kup.conf"

  deadline=$((SECONDS + GALILEO_PROMPT_SYNC_TIMEOUT_SEC))
  while (( SECONDS < deadline )); do
    runtime_info="$(kctl -n "${GALILEO_NAMESPACE}" exec "${app_pod}" -- python -c \
      'import os; from pathlib import Path; from src.splunk_ao_langgraph_fsi_agent.prompt_profiles import resolve_supervisor_prompt; print(Path(os.environ["SUPERVISOR_PROMPT_PROFILE_FILE"]).read_text().strip()+"\t"+resolve_supervisor_prompt()[0])' \
      2>/dev/null || true)"
    IFS=$'\t' read -r mounted_profile resolved_profile <<< "${runtime_info}"
    if [[ "${mounted_profile}" == "${GALILEO_SUPERVISOR_PROMPT_PROFILE}" && \
      "${resolved_profile}" == "${GALILEO_SUPERVISOR_PROMPT_PROFILE}" ]]; then
      log "Galileo prompt ConfigMap, projected volume, and application resolver use ${resolved_profile}"
      return 0
    fi
    (( SECONDS < deadline )) || break
    sleep 2
  done
  die "Galileo prompt projection did not converge to ${GALILEO_SUPERVISOR_PROMPT_PROFILE} within ${GALILEO_PROMPT_SYNC_TIMEOUT_SEC}s"
}

validate_galileo_runtime() {
  local deployed_image source_pod app_pod attempt
  deployed_image="$(kctl -n "${GALILEO_NAMESPACE}" get deployment splunk-ao-banking-qwen \
    -o jsonpath='{.spec.template.spec.containers[?(@.name=="banking-chatbot")].image}')"
  [[ "${deployed_image}" == "${GALILEO_IMAGE_REF}" ]] \
    || die "Galileo deployment image does not match GALILEO_IMAGE_REF"

  validate_service_endpoint "${GALILEO_NAMESPACE}" splunk-ao-banking-qwen
  source_pod="$(kctl -n "${TEST_NAMESPACE}" get pod -l app=testcurl \
    -o jsonpath='{.items[0].metadata.name}')"
  [[ -n "${source_pod}" ]] || die "no testcurl pod is available for Galileo HTTP validation"
  kctl -n "${TEST_NAMESPACE}" exec "${source_pod}" -- curl -fsS --max-time 30 \
    "http://splunk-ao-banking-qwen.${GALILEO_NAMESPACE}.svc.cluster.local/" >/dev/null

  for ((attempt = 1; attempt <= 3; attempt++)); do
    app_pod="$(kctl -n "${GALILEO_NAMESPACE}" get pod \
      -l app.kubernetes.io/name=splunk-ao-banking-qwen -o json | python3 -c '
import json, sys
for pod in json.load(sys.stdin).get("items", []):
    if pod.get("metadata", {}).get("deletionTimestamp"):
        continue
    conditions = pod.get("status", {}).get("conditions", [])
    if any(item.get("type") == "Ready" and item.get("status") == "True" for item in conditions):
        print(pod["metadata"]["name"])
        break
')"
    if [[ -n "${app_pod}" ]]; then
      validate_galileo_prompt_runtime "${app_pod}"
      if kctl -n "${GALILEO_NAMESPACE}" exec "${app_pod}" -- python pod_network_smoke.py; then
        log "Galileo banking chatbot prompt switching, image, HTTP service, model, Pinecone, and Splunk AO checks passed"
        return 0
      fi
    fi
    if (( attempt < 3 )); then
      log "Galileo Pod validation attempt ${attempt}/3 failed; retry in 5 seconds"
      sleep 5
    fi
  done
  die "Galileo Pod outbound validation failed"
}

validate_tetragon_runtime() {
  local pods pod policy_count alert_count tetragon_logs
  pods="$(kctl -n kube-system get pod \
    -l app.kubernetes.io/component=agent,app.kubernetes.io/name=tetragon \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')"
  [[ -n "${pods}" ]] || die "no Tetragon agent pods found"

  while IFS= read -r pod; do
    [[ -n "${pod}" ]] || continue
    tetragon_logs="$(kctl -n kube-system logs "${pod}" -c tetragon --tail=20000)"
    if ! grep -F 'HaveProgramType(ebpf.LSM) = true' <<< "${tetragon_logs}" >/dev/null; then
      die "Tetragon did not confirm eBPF LSM program support in pod ${pod}"
    fi
    kctl -n kube-system exec "${pod}" -c tetragon -- \
      sh -c 'test -s /var/run/cilium/hubble/tetragon.log' \
      || die "Tetragon network event export is empty in pod ${pod}"
    kctl -n kube-system exec "${pod}" -c tetragon -- sh -c '
      for file in /var/run/cilium/hubble/alert/*; do
        if [ -s "$file" ]; then
          exit 0
        fi
      done
      exit 1
    ' || die "Tetragon alert export is empty in pod ${pod}"
  done < <(printf '%s\n' "${pods}")

  policy_count="$(kctl get tracingpolicies -o name 2>/dev/null | awk 'END {print NR+0}')"
  alert_count="$(kctl get alertrules -o name 2>/dev/null | awk 'END {print NR+0}')"
  [[ "${policy_count}" -gt 0 ]] || die "no Tetragon TracingPolicy objects are loaded"
  [[ "${alert_count}" -gt 0 ]] || die "no Tetragon AlertRule objects are loaded"
  log "Tetragon policies loaded: tracingpolicies=${policy_count}, alertrules=${alert_count}"
}

validate_service_endpoint() {
  local namespace="$1"
  local service="$2"
  local endpoint attempt
  for ((attempt = 1; attempt <= 60; attempt++)); do
    endpoint="$(kctl -n "${namespace}" get endpointslices.discovery.k8s.io \
      -l "kubernetes.io/service-name=${service}" \
      -o jsonpath='{.items[0].endpoints[0].addresses[0]}' 2>/dev/null || true)"
    if [[ -n "${endpoint}" ]]; then
      return 0
    fi
    sleep 5
  done
  kctl -n "${namespace}" describe service "${service}" || true
  die "service did not get a ready endpoint: ${namespace}/${service}"
}

validate_hubble_timescape_pipeline() {
  local attempt pods pod fluentd_logs timescape_logs missing
  for ((attempt = 1; attempt <= 60; attempt++)); do
    pods="$(kctl -n kube-system get pod -l app.kubernetes.io/instance=hubble-enterprise \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
    missing=0
    while IFS= read -r pod; do
      [[ -n "${pod}" ]] || continue
      fluentd_logs="$(kctl -n kube-system logs "${pod}" --tail=2000 2>/dev/null || true)"
      if ! grep -F 'following tail of /var/run/cilium/hubble/hubble.log' \
        <<< "${fluentd_logs}" >/dev/null; then
        missing=1
      fi
    done <<< "${pods}"

    timescape_logs="$(kctl -n kube-system logs hubble-timescape-lite-0 \
      -c timescape --since=10m 2>/dev/null || true)"
    if [[ -n "${pods}" && "${missing}" -eq 0 ]] && \
      grep -E 'push(\.insert)?\.flows\.flushed=[1-9][0-9]*(\.[0-9]+)?/s' \
        <<< "${timescape_logs}" >/dev/null; then
      log "Hubble Enterprise is tailing every node and Timescape is flushing historical flows"
      return 0
    fi
    sleep 5
  done
  die "Hubble Enterprise to Timescape historical flow pipeline did not become active"
}

