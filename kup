log "install Tetragon Enterprise"
helm_upgrade tetragon isovalent/tetragon \
  --version "${TETRAGON_CHART_VER}" \
  --namespace kube-system \
  -f "${TETRAGON_VALUES}"
kctl -n kube-system rollout status daemonset/tetragon --timeout="${TETRAGON_ROLLOUT_TIMEOUT}"
if kctl -n kube-system get deployment tetragon-operator >/dev/null 2>&1; then
  kctl -n kube-system rollout status deployment/tetragon-operator --timeout="${TETRAGON_ROLLOUT_TIMEOUT}"
fi

log "install Tetragon Policy Ruleset"
helm_upgrade tetragon-policies isovalent/tetragon-policies \
  --version "${TPR_CHART_VER}" \
  --namespace kube-system \
  -f "${TPR_VALUES}" \
  --wait --timeout "${TETRAGON_ROLLOUT_TIMEOUT}"

log "deploy Alibaba-friendly test and mini-boutique workloads"
ensure_namespace "${TEST_NAMESPACE}"
ensure_namespace "${DEMO_NAMESPACE}"
kctl apply -f "${SCRIPT_DIR}/ns_test/testcurl.yaml"
kctl apply -f "${SCRIPT_DIR}/ns_demo/mini-boutique-lite.yaml"
kctl -n "${TEST_NAMESPACE}" rollout status daemonset/testcurl --timeout=15m
kctl -n "${DEMO_NAMESPACE}" wait --for=condition=Available deployment --all --timeout=20m
kctl -n "${DEMO_NAMESPACE}" wait --for=condition=Ready pod --all --timeout=20m

log "apply non-blocking Cilium L7 visibility policy"
kctl apply -f "${SCRIPT_DIR}/ns_demo/cnp-l7-visibility.yaml"

validate_application_networking
validate_tetragon_runtime

log "final component summary"
kctl get nodes -o wide
kctl -n kube-system get pods -o wide
kctl -n "${TEST_NAMESPACE}" get pods -o wide
kctl -n "${DEMO_NAMESPACE}" get pods -o wide
hctl list --all-namespaces

cat <<EOF

================================================================
NEXT STEPS
----------------------------------------------------------------
# Hubble UI Enterprise (live Hubble Relay + historical Timescape)
kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" \\
  -n kube-system port-forward svc/hubble-ui "${HUBBLE_UI_LOCAL_PORT}:80"
# Open http://127.0.0.1:${HUBBLE_UI_LOCAL_PORT}

# ACK and Cilium
kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" get nodes -o wide
kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" \\
  -n kube-system exec daemonset/cilium -c cilium-agent -- cilium-dbg status

# Tetragon policies
kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" get tracingpolicies
kubectl --kubeconfig "${KUBECONFIG_FILE}" --context "${ACK_CONTEXT}" get alertrules

# Destroy the complete disposable demo
${SCRIPT_DIR}/kiall
================================================================
EOF

log "SUCCESS: ACK BYOCNI demo converged using project-private context ${ACK_CONTEXT}"
